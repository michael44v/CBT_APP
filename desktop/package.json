{
  "name": "cbt-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "productName": "CBT Practice App",
  "scripts": {
    "dev": "vite",
    "build:react": "vite build",
    "electron": "wait-on http://localhost:5173 && electronmon .",
    "start": "concurrently \"npm run dev\" \"npm run electron\"",
    "dist": "npm run build:react && electron-builder",
    "dist:mac": "npm run build:react && electron-builder --mac",
    "dist:win": "npm run build:react && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "28.3.3",
    "electron-builder": "^26.15.3",
    "electronmon": "^2.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.cbt.app",
    "npmRebuild": false,
    "productName": "CBT Practice App",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education",
      "icon": "../build/icon.icns"
    },
    "win": {
      "target": "portable",
      "icon": "../build/icon.ico"
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
